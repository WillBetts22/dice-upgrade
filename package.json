{
  "name": "dice-upgrade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "tsx src/tools/balance.ts",
    "simulate": "tsx src/tools/simulate.ts",
    "strategy-tables": "tsx src/tools/strategy-tables.ts",
    "ev-table": "tsx src/tools/ev-table.ts",
    "strategy-pdf": "cd docs/strategy && tectonic -X compile strategy.tex"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
